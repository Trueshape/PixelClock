{
  "name": "pixelclock",
  "version": "0.1.0",
  "description": "Display LED 64x16 in pixel art, sempre sopra, con testo che scorre",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "snapshot": "electron . --snapshot",
    "dist": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.pixelclock.app",
    "productName": "PixelClock",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "renderer.js",
      "font.js"
    ],
    "win": {
      "target": "portable"
    },
    "portable": {
      "artifactName": "PixelClock.exe"
    },
    "directories": {
      "output": "release"
    }
  }
}
